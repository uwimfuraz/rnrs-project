                            id="resume-upload"
                            disabled={resumeUpload.isUploading}
                          />
                          <label htmlFor="resume-upload">
                            <Button 
                              asChild
                              className="w-full cursor-pointer bg-gradient-to-r from-primary to-blue-600"
                              disabled={resumeUpload.isUploading}
