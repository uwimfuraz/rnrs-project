                      </div>
                      <Button size="sm" className="w-full bg-gradient-to-r from-green-600 to-green-700 hover:from-green-700 hover:to-green-800" asChild>
                        <Link href={`/jobs/${job.id}`}>
                          <Eye className="h-4 w-4 mr-2" />
