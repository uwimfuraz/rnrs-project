}

.dark {
  /* Dark theme with proper contrast and red accents */
  --background: 2 6 23;
  --foreground: 248 250 252;
  --card: 15 23 42;
  --card-foreground: 248 250 252;
  --popover: 15 23 42;
  --popover-foreground: 248 250 252;

  /* Primary colors adjusted for dark theme visibility */
  --primary: 165 42 42; /* Lighter maroon for better visibility in dark mode */
  --primary-foreground: 248 250 252;
  --primary-light: 205 92 92;
  --primary-dark: 128 0 0;

  --secondary: 30 41 59;
  --secondary-foreground: 248 250 252;

  --muted: 30 41 59;
  --muted-foreground: 148 163 184;
  --accent: 30 41 59;
  --accent-foreground: 248 250 252;

  --success: 34 197 94;
  --success-foreground: 2 6 23;
  --destructive: 239 68 68;
  --destructive-foreground: 2 6 23;

  --border: 30 41 59;
  --input: 30 41 59;
  --ring: 165 42 42;

  --chart-1: 165 42 42;
  --chart-2: 34 197 94;
  --chart-3: 251 191 36;
  --chart-4: 168 85 247;
  --chart-5: 59 130 246;

  --sidebar: 15 23 42;
  --sidebar-foreground: 248 250 252;
  --sidebar-primary: 165 42 42;
  --sidebar-primary-foreground: 248 250 252;
  --sidebar-accent: 30 41 59;
  --sidebar-accent-foreground: 248 250 252;
