        } else {
          setError("Failed to update profile. Please try again.")
        }
      } catch (err) {
        setError("An error occurred. Please try again.")
      } finally {
        setIsSubmitting(false)
      }
    } else {
      nextStep()
    }
  }

  const handleSkip = () => {
    router.push("/dashboard")
  }

  const progressPercentage = (currentStep / steps.length) * 100
